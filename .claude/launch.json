{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eps-frontend",
      "autoPort": true,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/eps", "run", "dev"],
      "port": 5173,
      "env": {
        "BASE_PATH": "/",
        "NODE_ENV": "development",
        "MSYS_NO_PATHCONV": "1",
        "MSYS2_ARG_CONV_EXCL": "*"
      }
    }
  ]
}
